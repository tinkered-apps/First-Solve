    "@playwright/test": "1.63.0",
    "eslint": "10.12.0",
    "globals": "17.13.0",
    "wrangler": "4.149.0"
  },
  "allowScripts": {
    "esbuild@0.28.2": true,
    "workerd@1.20261006.1": true
  }
}
